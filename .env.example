# Flask session signing key — generate a long random value for production
SECRET_KEY=replace-with-a-long-random-string

# Single administrator credentials (do not commit real values)
PULSEWATCH_USERNAME=admin
# Generate a hash:
#   python scripts/hash_password.py
PULSEWATCH_PASSWORD_HASH=pbkdf2:sha256:600000$nThO5L196ApoHXzi$0b0bb21358bdb650497849231ea3320a7ae1f141da6715321061819ccb889bb2

# development | production
PULSEWATCH_ENV=development

# SQLite URL. Docker Compose mounts a persistent volume at /app/instance
DATABASE_URL=sqlite:///pulsewatch.db

# Set true behind HTTPS (Azure App Service)
SESSION_COOKIE_SECURE=false

# Optional listen port (Azure: WEBSITES_PORT / PORT)
PORT=5000
